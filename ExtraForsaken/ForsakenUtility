--// local functions
local function ResolveType(t, path)
	local parts = path:split(".")
	local current = t
	for _, part in ipairs(parts) do
		if typeof(current) ~= "table" then return nil end
		if current[part] ~= nil then
			current = current[part]
		elseif current[tonumber(part)] ~= nil then
			current = current[tonumber(part)]
		else
			local found = false
			for k, v in pairs(current) do
				if tostring(k):lower() == part:lower() then
					current = v
					found = true
					break
				end
			end
			if not found then return nil end
		end
	end
	return current
end

local function OutputDebug(Scope,Message)
	if Util.DebugMode == false then
		return
	end
	
	if Scope and not Message then
		Message = Scope
		Scope = "Warning"
	end
	
	if Scope and Message then
		if Scope == "Printing" then
			warn("[SCRIPT UTIL]: " .. Message)
		elseif Scope == "Warning" then
			warn("[SCRIPT UTIL]: " .. Message)
		else
			warn("[SCRIPT UTIL]: Can only PRINT and WARN with OutputDebug")
		end
	else
		warn("[SCRIPT UTIL]: No scope or message input")
	end
end

