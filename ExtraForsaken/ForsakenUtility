local ENCODERS = {}

local function encodeValue(Value)
	local encoder = ENCODERS[typeof(Value)]
	if not encoder then
		OutputDebug("Invalid value type: " .. typeof(Value))
		return nil
	end
	return encoder(Value)
end

ENCODERS = {
	string = function(s)
		local b = buffer.create(5 + #s)
		buffer.writeu8(b, 0, 3)
		buffer.writeu32(b, 1, #s)
		buffer.writestring(b, 5, s)
		return b
	end,
	number = function(n)
		local b = buffer.create(9)
		buffer.writeu8(b, 0, 2)
		buffer.writef64(b, 1, n)
		return b
	end,
	boolean = function(v)
		local b = buffer.create(2)
		buffer.writeu8(b, 0, 4)
		buffer.writeu8(b, 1, v and 1 or 0)
		return b
	end,
	table = function(t)
		local encoded = {}
		for k, v in pairs(t) do
			local result = encodeValue(v)
			if result then
				encoded[k] = result
			else
				OutputDebug("Skipping key '" .. tostring(k) .. "' — unsupported type: " .. typeof(v))
			end
		end
		return encoded
	end,
}

