--[[
ListCharacter
Returns a list of the current characters in the game,Can exclude certain characters
]]--
Util.ListCharacter = function(Type: string, Exclusion: {string}?)
	local ExcludeList,Found = {},{}
	
	if typeof(Type) ~= "string" then
		OutputDebug("Warning","ListCharacter : Type passed is not a string")
		return
	end
	
	if Exclusion and (typeof(Exclusion) ~= "table") then
		OutputDebug("Warning","ListCharacter : Exclusion passed is not a table")
		return
	elseif Exclusion then
		for _, v in ipairs(Exclusion) do
			ExcludeList[v] = true
		end
	end
	
	local TypeFolder = Assets:FindFirstChild(Type)
	if TypeFolder then
		for _, character in pairs(TypeFolder:GetChildren()) do
			if character:IsA("Folder") and not ExcludeList[character.Name] then
				table.insert(Found,character.Name)
			end
		end
		return Found or {}
	else
		OutputDebug("Warning","ListCharacter : Could not find Type passed")
		return Found or {}
	end
end

