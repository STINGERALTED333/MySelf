--[[
ReturnTerrorRadius
Returns a table of IDS that are the select terror radius
Options : Layer1 , Layer2 , Layer3 , Chase
]]--
Util.ReturnTerrorRadius = function(TerrorRadius: string)
	if typeof(TerrorRadius) ~= "string" then
		OutputDebug("Warning", "Input TerrorRadius is not a string")
		return {}
	end

	local Characters, Found = Util.ListCharacter("Killers", {}), {}

	local function ReturnRadius(Character: string)
		local info = Util.ForsakenInfo.TerrorDistances[Character]
			or Util.ForsakenDefaults.TerrorDistances["Default"]
		return info and info[TerrorRadius] or 60
	end

	for _, v in pairs(Characters) do
		if KillersFolder:FindFirstChild(v) then
			local radius = ReturnRadius(v)
			local path = "Sounds.TerrorRadiusThemes." .. tostring(radius)
			local LocalFound = Util.ReturnIDType("idk", v, {"Config." .. path}) or {}
			for _, t in pairs(LocalFound) do
				if typeof(t) == "string" and t:find("rbxassetid") then
					table.insert(Found, t)
				end
			end
		end
	end

	return Found
end

--[[
TemporaryBlockConnection
ConnectionName = Name of the connection you want to block
ConnectionType = Type of connection you want to block eg "RemoteEvent"
Duration = How long you want to block the connection name and type from firing to the server for
]]--
local BypassList = {}  
Util.TemporaryBlockConnection = function(ConnectionName: string, Duration: number, ConnectionType: string?)
	if not (ConnectionName and typeof(ConnectionName) == "string")
		or not (Duration and typeof(Duration) == "number") then
		OutputDebug("Warning", "Passed connection name or type is not valid")
		return
	end
	ConnectionType = ConnectionType or "RemoteEvent"
	OutputDebug("Warning", "Blocking event " .. ConnectionName .. " type " .. ConnectionType)
	local Remote = game.ReplicatedStorage.Modules.Network:FindFirstChild(ConnectionType)
	if not Remote then
		OutputDebug("Warning", "Event not found: " .. ConnectionType)
		return
	end
	local Blocked = true
	local OriginalNamecall
	OriginalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		if self == Remote and getnamecallmethod() == "FireServer" then
			local args = {...}
			if Blocked and args[1] == ConnectionName and not BypassList[ConnectionName] then
				OutputDebug("Warning", "Blocked: " .. ConnectionName)
				return
			end
		end
		return OriginalNamecall(self, ...)
	end)
	task.delay(Duration, function()
		Blocked = false
		OutputDebug("Warning", "Unblocked: " .. ConnectionName)
	end)
end

Util.TemporaryFireConnection = function(ConnectionName: string, ConnectionType: string?, ...)
	ConnectionType = ConnectionType or "RemoteEvent"
	local Remote = game.ReplicatedStorage.Modules.Network:FindFirstChild(ConnectionType)
	if not Remote then
		OutputDebug("Warning", "TemporaryFireConnection : Event not found: " .. ConnectionType)
		return
	end
	BypassList[ConnectionName] = true
	Remote:FireServer(ConnectionName, ...)
	BypassList[ConnectionName] = nil
end

