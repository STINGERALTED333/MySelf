local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local Drawings = {}
local CharacterConnections = {}
local MainLoop = nil

local LINES = {
    {"Head",  "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local function CreateSkeletonLines()
    local drawings = {}
    for _, pair in ipairs(LINES) do
        local line = Drawing.new("Line")
        line.Color      = Color3.new(1, 1, 1)
        line.Thickness  = 2
        line.Transparency = 1
        line.Visible    = false
        table.insert(drawings, {line = line, p1 = pair[1], p2 = pair[2]})
    end
    return drawings
end

local function ClearDrawings(player)
    if Drawings[player] then
        for _, d in ipairs(Drawings[player]) do
            d.line:Remove()
        end
        Drawings[player] = nil
    end
end

local function UpdateSkeleton(player)
    local character = player.Character
    if not character then
        ClearDrawings(player)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        ClearDrawings(player)
        return
    end

    if not character:FindFirstChild("Torso") then
        ClearDrawings(player)
        return
    end

    -- recreate if missing (respawn case)
    if not Drawings[player] then
        Drawings[player] = CreateSkeletonLines()
    end

    for _, d in ipairs(Drawings[player]) do
        local p1 = character:FindFirstChild(d.p1)
        local p2 = character:FindFirstChild(d.p2)

        if p1 and p2 then
            local s1, v1 = Camera:WorldToViewportPoint(p1.Position)
            local s2, v2 = Camera:WorldToViewportPoint(p2.Position)

            if v1 and v2 and s1.Z > 0 then
                d.line.From    = Vector2.new(s1.X, s1.Y)
                d.line.To      = Vector2.new(s2.X, s2.Y)
                d.line.Visible = true
            else
                d.line.Visible = false
            end
        else
            d.line.Visible = false
        end
    end
end

local function WatchPlayer(player)
    if player == LocalPlayer then return end

    -- handle respawns: recreate drawings on new character
    CharacterConnections[player] = player.CharacterAdded:Connect(function()
        ClearDrawings(player) -- wipe old lines, UpdateSkeleton will recreate
    end)
end

local function UnwatchPlayer(player)
    ClearDrawings(player)
    if CharacterConnections[player] then
        CharacterConnections[player]:Disconnect()
        CharacterConnections[player] = nil
    end
end

MainLoop = RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            UpdateSkeleton(player)
        end
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    WatchPlayer(player)
end

Players.PlayerAdded:Connect(WatchPlayer)
Players.PlayerRemoving:Connect(UnwatchPlayer)

LocalPlayer.CharacterRemoving:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            ClearDrawings(player)
        end
    end
end)
