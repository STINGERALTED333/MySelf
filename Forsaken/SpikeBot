local ANIM_ID_SET = {}
for _, v in ipairs(CONFIG.ANIM_IDS) do
    local id = tonumber(tostring(v):match("%d+"))
    if id then
        ANIM_ID_SET[id] = true
        ANIM_ID_SET["rbxassetid://" .. id] = true
    end
end
local function isTrackedAnim(animId)
    local numId = tonumber(tostring(animId):match("%d+"))
    return ANIM_ID_SET[animId] or (numId and ANIM_ID_SET[numId])
end

