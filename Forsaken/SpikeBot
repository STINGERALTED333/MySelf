local destroyed = false
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or input.KeyCode ~= Enum.KeyCode.F8 or destroyed then return end
    destroyed = true
    stopAimLoop()
    if trackConn then trackConn:Disconnect(); trackConn = nil end
    clearHighlight()
    stopClickTargeting()
    SpikeGUI:Destroy()
    warn("JohnDoe spike aim destroyed (F8)")
end)
