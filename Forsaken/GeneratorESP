}

type HighlightConfig = {
    FillColor: Color3,
    FillColorOccluded: Color3,
    OutlineColor: Color3,
    OutlineColorOccluded: Color3,
    FillTransparency: number,
    FillTransparencyOccluded: number,
    OutlineTransparency: number,
    OutlineTransparencyOccluded: number,
    BoxColor: Color3,
    BoxThickness: number,
    BoxTransparency: number,        -- when fully visible
    BoxTransparencyOccluded: number, -- when occluded (box fades)
    ShowBox: boolean,
    ShowThroughWalls: boolean,
}

type Config = {
    GeneratorHighlight: HighlightConfig,
    FakeGeneratorHighlight: HighlightConfig,
    TweenInfo: TweenInfo,
    DisableInfo: TweenInfo,
    OcclusionInterval: number,
    SeeConfig: SeeConfig
}

