Config.EnabledCheck = function()
    if not LocalPlayer.Character then return false end
    if IsCrouching() then return false end
    local char = LocalPlayer.Character
    local parent = char.Parent
    if parent == SpectatorFolder then return Config.SeeConfig.Spectator end
    if parent == SurvivorsFolder then return Config.SeeConfig.Survivor end
    if parent == KillerFolder    then return Config.SeeConfig.Killer end
    return Config.SeeConfig.Other
end

