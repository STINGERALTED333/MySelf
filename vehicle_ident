#!/usr/bin/env python3
"""
StingerMIDENT Vehicle Identifier API
-------------------------------------
Self-installing. Run once with:  python3 vehicle_identifier.py

On startup it will:
  1. Install all pip dependencies
  2. Download ResNet-50 weights (~100MB, cached after first run)
  3. Start a FastAPI server on localhost:8000
  4. Open a public localtunnel URL at https://stingermident.loca.lt

POST /identify
  Body: multipart/form-data  { "image": <file> }
  Returns JSON: { "result": "Tank", "confidence": 82.3, "scores": {...}, "raw_top5": [...] }

GET /health
  Returns: { "status": "ok" }
"""

import subprocess, sys, os

# ── Step 1: self-install dependencies ────────────────────────────────────────
REQUIRED = ["torch", "torchvision", "Pillow", "fastapi", "uvicorn[standard]", "python-multipart"]

def install(pkg):
    print(f"  Installing {pkg}...")
    subprocess.check_call(
        [sys.executable, "-m", "pip", "install", pkg, "--break-system-packages", "-q"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )

print("=" * 55)
print("  StingerMIDENT Vehicle Identifier — Setup")
print("=" * 55)
print("\n[1/3] Checking dependencies...")
for pkg in REQUIRED:
    base = pkg.split("[")[0]
    try:
        __import__(base.replace("-", "_"))
    except ImportError:
        install(pkg)
print("      All dependencies ready.\n")

# ── Step 2: check localtunnel ─────────────────────────────────────────────────
def check_lt():
    result = subprocess.run(["which", "lt"], capture_output=True)
    if result.returncode != 0:
        print("  Installing localtunnel (requires npm)...")
        subprocess.check_call(["npm", "install", "-g", "localtunnel"],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

check_lt()

# ── Step 3: load model ────────────────────────────────────────────────────────
print("[2/3] Loading ResNet-50 (downloads ~100MB once, then cached)...")
import torch
import torchvision.models as models
import torchvision.transforms as transforms
from PIL import Image
import urllib.request, json, io, threading, time

model = models.resnet50(weights=models.ResNet50_Weights.IMAGENET1K_V2)
model.eval()

print("      Loading ImageNet labels...")
url = "https://raw.githubusercontent.com/anishathalye/imagenet-simple-labels/master/imagenet-simple-labels.json"
with urllib.request.urlopen(url) as r:
    IMAGENET_LABELS = json.load(r)

print("      Model ready.\n")

# ── Category mapping ──────────────────────────────────────────────────────────
IMAGENET_TO_CATEGORY = {
    403:"Plane", 404:"Plane", 895:"Plane",
    405:"Blimp", 417:"Blimp",
    449:"Boat",  510:"Boat",  554:"Boat",  625:"Boat",
    724:"Boat",  814:"Boat",  913:"Boat",
    475:"Car",   479:"Car",   569:"Car",   575:"Car",
    654:"Car",   671:"Car",   690:"Car",   705:"Car",
    717:"Car",   751:"Car",   779:"Car",   791:"Car",
    817:"Car",   864:"Car",   867:"Car",   874:"Car",  565:"Car",
    847:"Tank",
    833:"Submarine",
    657:"Weapon",
}

KEYWORD_FALLBACK = {
    "rocket":"Rocket",    "spacecraft":"Rocket",
    "missile":"Weapon",   "gun":"Weapon",    "cannon":"Weapon",
    "tank":"Tank",        "submarine":"Submarine",
    "helicopter":"Plane", "warplane":"Plane",
    "zeppelin":"Blimp",
    "mech":"Mech",        "robot":"Mech",
    "building":"Structure","tower":"Structure","bridge":"Structure",
}

TRANSFORM = transforms.Compose([
    transforms.Resize(256),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225]),
])

def run_inference(image_bytes: bytes):
    image = Image.open(io.BytesIO(image_bytes)).convert("RGB")
    tensor = TRANSFORM(image).unsqueeze(0)
    with torch.no_grad():
        probs = torch.softmax(model(tensor), dim=1)[0]

    top_probs, top_indices = torch.topk(probs, 10)
    category_scores: dict[str, float] = {}

    for prob, idx in zip(top_probs.tolist(), top_indices.tolist()):
        label = IMAGENET_LABELS[idx].lower()
        cat = IMAGENET_TO_CATEGORY.get(idx)
        if not cat:
            cat = next((v for k, v in KEYWORD_FALLBACK.items() if k in label), "Other")
        category_scores[cat] = category_scores.get(cat, 0.0) + prob

    ranked = sorted(category_scores.items(), key=lambda x: x[1], reverse=True)
    raw_top5 = [
        {"label": IMAGENET_LABELS[i], "confidence": round(p * 100, 2)}
        for p, i in zip(top_probs[:5].tolist(), top_indices[:5].tolist())
    ]
    best_cat, best_score = ranked[0]
    return {
        "result": best_cat,
        "confidence": round(best_score * 100, 2),
        "scores": {k: round(v * 100, 2) for k, v in ranked if v > 0.001},
        "raw_top5": raw_top5,
    }

# ── Step 3: FastAPI app ───────────────────────────────────────────────────────
print("[3/3] Starting API server...")

from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.middleware.cors import CORSMiddleware
import uvicorn

app = FastAPI(title="StingerMIDENT Vehicle Identifier", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/health")
def health():
    return {"status": "ok", "model": "ResNet-50 ImageNet"}

@app.post("/identify")
async def identify(image: UploadFile = File(...)):
    if not image.content_type.startswith("image/"):
        raise HTTPException(status_code=400, detail="File must be an image.")
    data = await image.read()
    if len(data) > 20 * 1024 * 1024:
        raise HTTPException(status_code=413, detail="Image too large (max 20MB).")
    try:
        return run_inference(data)
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# ── Launch localtunnel after server starts ────────────────────────────────────
PORT = 8000
SUBDOMAIN = "stingermident"

def launch_tunnel():
    time.sleep(2)  # wait for uvicorn to be ready
    print("\n" + "=" * 55)
    print("  Opening public tunnel...")
    proc = subprocess.Popen(
        ["lt", "--port", str(PORT), "--subdomain", SUBDOMAIN],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    for line in proc.stdout:
        line = line.strip()
        if line:
            print(f"\n  🌐 Public URL: {line}")
            print(f"\n  POST https://stingermident.loca.lt/identify")
            print(f"       (multipart/form-data, field name: 'image')\n")
            print(f"  GET  https://stingermident.loca.lt/health\n")
            print("  Press Ctrl+C to stop.\n")
            print("=" * 55)
            break

threading.Thread(target=launch_tunnel, daemon=True).start()

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=PORT, log_level="warning")
